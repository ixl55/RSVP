# ==== إعدادات التطبيق ====
APP_NAME="نظام تأكيد الحضور"
EVENT_NAME="مؤتمر يوم الشباب العالمي - العراق"
EVENT_PLACE="فندق موفنبيك - المنطقة الخضراء"

# ==== قاعدة البيانات ====
DATABASE_URL="sqlite:///./data/attendance.db"

# ==== الأمان (غيّرها قبل النشر) ====
SECRET_KEY="change-me-please-use-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ==== حساب الأدمن الافتراضي (يُنشأ تلقائياً عند أول تشغيل) ====
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@12345"

# ==== CORS ====
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==== تحديد المحاولات لكل عنوان IP ====
# ارفع ATTENDANCE_RATE_LIMIT إذا كان الحضور يتصلون عبر شبكة واحدة مشتركة في القاعة
ATTENDANCE_RATE_LIMIT=40
ATTENDANCE_RATE_WINDOW=300
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW=300

# ==== المنطقة الزمنية للعرض والتصدير ====
TIMEZONE="Asia/Baghdad"
